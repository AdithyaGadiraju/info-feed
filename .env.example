# ---- Required ----

# Supabase Postgres. Use the Supavisor POOLER connection string (transaction mode),
# not the direct 5432 string. Project dashboard -> Connect -> Transaction pooler.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Discord webhook for the main channel. Every lane is always posted here.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Basic auth for the web feed. Only safe behind HTTPS (see README deploy notes).
FEED_USER=gadi
FEED_PASS=change-me

# Timezone for the worker's digest schedule and all rendered timestamps.
TZ=Australia/Sydney

# ---- Optional: per-lane mirror channels ----
# If set, that lane's message is ALSO posted here, in addition to the main channel.
DISCORD_WEBHOOK_URL_AI=
DISCORD_WEBHOOK_URL_AI_DEV=
DISCORD_WEBHOOK_URL_MARKETS=
DISCORD_WEBHOOK_URL_BETTING=
DISCORD_WEBHOOK_URL_GAMEDEV=
DISCORD_WEBHOOK_URL_GAMES=

# ---- Optional: Twitter, from a THROWAWAY account only ----
# Never use a main account. Leave empty to skip Twitter entirely (the v1 default).
# Generate with: npx rettiwt-api auth login "<email>" "<username>" "<password>"
RETTIWT_API_KEY=

# ---- Dials ----

# 'cli'  -> spawn the local `claude` CLI, authenticated by the Claude subscription (default, v1).
# 'api'  -> @anthropic-ai/sdk with ANTHROPIC_API_KEY (needed before any VPS deploy, TODO T1).
LLM_TRANSPORT=cli

# Exact model id, never with a date suffix.
# claude-sonnet-5 (default) | claude-haiku-4-5 (cheap) | claude-opus-5 (quality)
LLM_MODEL=claude-sonnet-5

# Only used with LLM_TRANSPORT=api.
ANTHROPIC_API_KEY=

# Hard ceiling on what a single model call may spend. A runaway response is the
# only way one call can cost real money; the worst real call so far was $0.21.
LLM_MAX_CALL_USD=1

# Worker enrichment cadence in minutes. Set to 999 during development to stop
# the worker spending tokens, and trigger runs by hand with `npm run enrich:once`.
ENRICH_INTERVAL_MIN=60

# Port for `next start`.
PORT=3005

# Base URL used for the story links inside Discord digests.
FEED_BASE_URL=http://localhost:3005
